{
  "scripts": {
    "start": "npm-run-all --parallel css eleventy browsersync",
    "eleventy": "eleventy --watch",
    "debug": "set DEBUG=* & eleventy",
    "css": "postcss src/static/css/tailwind.css --o _site/static/css/style.css --watch",
    "build": "cross-env NODE_ENV=production eleventy && cross-env NODE_ENV=production postcss src/static/css/tailwind.css --o _site/static/css/style.css",
    "browsersync": "browser-sync start --server _site --files _site --port 8080 --no-notify --no-open"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.14",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@contentful/rich-text-html-renderer": "^17.1.5",
    "alpinejs": "^3.15.0",
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.4",
    "contentful": "^11.8.5",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.1",
    "dotenv": "^17.2.3",
    "html-minifier": "^4.0.0",
    "js-yaml": "^4.1.0",
    "luxon": "^3.7.2",
    "npm-run-all": "^4.1.5",
    "prismjs": "^1.30.0",
    "netlify-cli": "^23.9.1"
  }
}
